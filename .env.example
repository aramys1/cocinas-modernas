# Origin only. Required before a public launch; rebuild after changes.
# Leave empty locally: fallback http://localhost:3000, noindex, empty sitemap.
NEXT_PUBLIC_SITE_URL=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_EMAIL=
# Required in production. Use a sender on your verified Resend domain.
# In development only, onboarding@resend.dev is used when this is empty.
RESEND_FROM_EMAIL=

# Optional. Empty values load no Analytics scripts / verification tag.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
